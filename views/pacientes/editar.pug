  style.
    .is-invalid { border-color: #dc3545 !important; box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25) !important; }
    .is-valid { border-color: #198754 !important; }

  script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
  script.
    let emailDuplicado = false;
    let fechaInvalida = false;

    const btnGuardar = document.getElementById('btnGuardar');
    const emailInput = document.getElementById('email');
    const emailOriginal = document.getElementById('email-original').value.trim();
    const checkUser = document.getElementById('editar_usuario');
    const password = document.getElementById('password');
    const repeatPassword = document.getElementById('repeatPassword');
    const nacimientoInput = document.getElementById('nacimiento');

    function validarFormulario() {
        let passMatch = true;
        if (checkUser.checked && (password.value !== "" || repeatPassword.value !== "")) {
            passMatch = (password.value === repeatPassword.value);
            if (!passMatch) {
                repeatPassword.classList.add('is-invalid');
            } else {
                repeatPassword.classList.remove('is-invalid');
                repeatPassword.classList.add('is-valid');
            }
        }
        btnGuardar.disabled = emailDuplicado || fechaInvalida || !passMatch;
    }

    // --- Manejo del Switch de Usuario ---
    checkUser.addEventListener('change', () => {
        emailInput.disabled = !checkUser.checked;
        password.disabled = !checkUser.checked;
        repeatPassword.disabled = !checkUser.checked;
        if (!checkUser.checked) {
            password.value = '';
            repeatPassword.value = '';
            emailInput.value = emailOriginal;
            emailInput.classList.remove('is-invalid', 'is-valid');
            emailDuplicado = false;
        }
        validarFormulario();
    });

    // --- Validación de Fecha ---
    nacimientoInput.addEventListener('input', function() {
        const fechaNac = new Date(this.value);
        const hoy = new Date();
        hoy.setHours(0, 0, 0, 0);
        let edad = hoy.getFullYear() - fechaNac.getFullYear();
        const m = hoy.getMonth() - fechaNac.getMonth();
        if (m < 0 || (m === 0 && hoy.getDate() < fechaNac.getDate())) edad--;

        const feedback = document.getElementById('nacimiento-feedback');
        if (this.value === "" || fechaNac >= hoy || edad > 110) {
            fechaInvalida = true;
            this.classList.add('is-invalid');
            feedback.textContent = edad > 110 ? "Máximo 110 años." : "Fecha no válida.";
        } else {
            fechaInvalida = false;
            this.classList.remove('is-invalid');
            this.classList.add('is-valid');
        }
        validarFormulario();
    });

    // --- Gestión de Teléfonos ---
    function marcarTelefonosModificados() {
        document.getElementById('tel-mod').value = '1';
    }

    function agregarTelefono() {
        marcarTelefonosModificados();
        const container = document.getElementById('telefonosContainer');
        const div = document.createElement('div');
        div.className = 'input-group mb-2 telefono-row animate__animated animate__fadeIn';
        div.innerHTML = `
            <input class="form-control form-control-sm telefono-input" type="text" name="telefonos" placeholder="Número" maxlength="15" required>
            <button class="btn btn-outline-danger btn-sm" type="button" onclick="eliminarTelefono(this)">
                <i class="bi bi-trash"></i>
            </button>`;
        div.querySelector('input').oninput = (e) => {
            e.target.value = e.target.value.replace(/[^0-9]/g, '');
            marcarTelefonosModificados();
        };
        container.appendChild(div);
    }

    function eliminarTelefono(btn) {
        if (document.querySelectorAll('.telefono-row').length === 1) {
            alert('Debe tener al menos un teléfono');
            return;
        }
        marcarTelefonosModificados();
        btn.closest('.telefono-row').remove();
    }

    // --- Validación Email AJAX ---
    emailInput.addEventListener('blur', async () => {
        const emailActual = emailInput.value.trim();
        if (emailActual === emailOriginal || emailActual === "") {
            emailInput.classList.remove('is-invalid');
            emailDuplicado = false;
            validarFormulario();
            return;
        }
        try {
            const res = await fetch(`/pacientes/verificar-email/${encodeURIComponent(emailActual)}`);
            const data = await res.json();
            emailDuplicado = data.existe;
            emailInput.classList.toggle('is-invalid', data.existe);
            emailInput.classList.toggle('is-valid', !data.existe);
            validarFormulario();
        } catch (e) { console.error(e); }
    });

    password.addEventListener('input', validarFormulario);
    repeatPassword.addEventListener('input', validarFormulario);

    // --- Confirmación de Estado (Activar/Inactivar) ---
    function confirmarEstado(accion) {
        Swal.fire({
            title: `¿Confirma ${accion} al paciente?`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: accion === 'inactivar' ? '#dc3545' : '#198754',
            confirmButtonText: 'Sí, confirmar'
        }).then((result) => {
            if (result.isConfirmed) document.getElementById(accion === 'inactivar' ? 'formInactivar' : 'formActivar').submit();
        });
    }

    // --- Envío de Formulario ---
    document.getElementById('formPaciente').onsubmit = function(e) {
        e.preventDefault();
        const tels = [...document.querySelectorAll('.telefono-input')].map(i => i.value.trim()).filter(Boolean);
        if (new Set(tels).size !== tels.length) {
            alert('No se permiten teléfonos duplicados');
            return;
        }

        if (!this.checkValidity() || emailDuplicado || fechaInvalida) {
            this.classList.add('was-validated');
            return;
        }

        Swal.fire({
            title: '¿Guardar cambios?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#0d6efd',
            confirmButtonText: 'Sí, guardar'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({ title: 'Procesando...', didOpen: () => Swal.showLoading(), allowOutsideClick: false });
                this.submit();
            }
        });
    };